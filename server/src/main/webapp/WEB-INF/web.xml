<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Library System</display-name>

    <servlet>
        <servlet-name>PublicationServlet</servlet-name>
        <servlet-class>com.library.servlet.PublicationServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>PublicationServlet</servlet-name>
        <url-pattern>/api/publications</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReaderServlet</servlet-name>
        <servlet-class>com.library.servlet.ReaderServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ReaderServlet</servlet-name>
        <url-pattern>/api/readers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>com.library.servlet.BookingServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/api/bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>IssuanceServlet</servlet-name>
        <servlet-class>com.library.servlet.IssuanceServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>IssuanceServlet</servlet-name>
        <url-pattern>/api/issuances</url-pattern>
    </servlet-mapping>

</web-app>
